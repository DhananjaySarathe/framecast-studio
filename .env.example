# Framecast: settings for guests joining from anywhere (Guests panel › "Anyone with a link (LiveKit Cloud)").
# Copy this file to .env, fill in your own values, then in Framecast click "Load .env file…".
# .env is git-ignored. After loading you can delete it: Framecast keeps the secret in your macOS Keychain.
# Set-up steps: docs/GUESTS.md. Only needed for remote guests; "This Mac" and "Wi-Fi" guests need none of this.

# Your LiveKit Cloud project URL (cloud.livekit.io › your project › Settings).
LIVEKIT_URL=wss://your-project.livekit.cloud

# An API key and its secret from the same project (the secret is shown once when you create the key).
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-api-secret

# Where you uploaded the guest page (./scripts/export_guest_page.sh makes the folder), ending in /.
GUEST_PAGE_URL=https://your-guest-page.pages.dev/
