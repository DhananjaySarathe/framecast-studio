{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framecast.local/schemas/asset-pack-manifest.v1.schema.json",
  "title": "Framecast Creator Asset Pack Manifest Schema v1",
  "description": "Proposed schema v1 for external and bundled Framecast creator asset packs. Distinct from Framecast's existing SceneCollection serialization format.",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "name",
    "coordinateSystem",
    "status",
    "assets",
    "missingAssetIds"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Manifest schema version."
    },
    "packId": {
      "type": "string",
      "const": "framecast-creator-assets-v1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "coordinateSystem": {
      "type": "string",
      "const": "normalized-top-left",
      "description": "All normalized rectangles (x, y, width, height) are in [0, 1] with origin (0, 0) at TOP LEFT of the displayed canvas. Core Image integrations must convert Y via y_ci = (1.0 - y - height) * pixelHeight."
    },
    "status": {
      "type": "string",
      "enum": ["complete", "partial"]
    },
    "missingAssetIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assetEntry" }
    }
  },
  "$defs": {
    "normalizedRect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "y": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "width": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "height": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "safeInsets": {
      "type": "object",
      "required": ["top", "right", "bottom", "left"],
      "additionalProperties": false,
      "properties": {
        "top": { "type": "number", "minimum": 0.0, "maximum": 0.5 },
        "right": { "type": "number", "minimum": 0.0, "maximum": 0.5 },
        "bottom": { "type": "number", "minimum": 0.0, "maximum": 0.5 },
        "left": { "type": "number", "minimum": 0.0, "maximum": 0.5 }
      }
    },
    "contentRegion": {
      "type": "object",
      "required": ["id", "role", "rect", "paddingNormalized", "cornerRadiusNormalized"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["quiet-content-zone", "countdown-slot", "handle-or-logo-slot", "qr-quiet-zone", "avatar-slot", "badge-slot", "card-surface"]
        },
        "rect": { "$ref": "#/$defs/normalizedRect" },
        "paddingNormalized": { "type": "number", "minimum": 0.0, "maximum": 0.25 },
        "cornerRadiusNormalized": { "type": "number", "minimum": 0.0, "maximum": 0.5 },
        "notes": { "type": "string" }
      }
    },
    "textRegion": {
      "type": "object",
      "required": [
        "id",
        "role",
        "rect",
        "alignment",
        "hierarchy",
        "maxLines",
        "relativeFontSize",
        "suggestedFont",
        "suggestedColor",
        "exampleText"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "rect": { "$ref": "#/$defs/normalizedRect" },
        "alignment": { "type": "string", "enum": ["left", "center", "right"] },
        "hierarchy": { "type": "string", "enum": ["primary", "secondary", "caption", "badge", "numeric"] },
        "maxLines": { "type": "integer", "minimum": 1, "maximum": 6 },
        "relativeFontSize": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 0.5,
          "description": "Font size normalized relative to canvas height."
        },
        "suggestedFont": { "type": "string" },
        "suggestedColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "exampleText": { "type": "string" }
      }
    },
    "transparentAperture": {
      "type": "object",
      "required": ["id", "role", "maskShape", "rect", "cornerRadiusNormalized", "suggestedSourceAspectRatio", "suggestedFitMode"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["camera", "shared-screen", "guest-camera"] },
        "maskShape": { "type": "string", "enum": ["rounded-rect", "circle"] },
        "rect": { "$ref": "#/$defs/normalizedRect" },
        "cornerRadiusNormalized": { "type": "number", "minimum": 0.0, "maximum": 0.5 },
        "suggestedSourceAspectRatio": { "type": "string" },
        "suggestedFitMode": { "type": "string", "enum": ["fill", "fit"] },
        "maskDescription": { "type": "string" }
      }
    },
    "variantEntry": {
      "type": "object",
      "required": [
        "path",
        "width",
        "height",
        "format",
        "colorSpace",
        "hasAlpha",
        "previewPath",
        "sha256",
        "safeInsets",
        "contentRegions",
        "textRegions",
        "transparentApertures"
      ],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "editableSourcePath": { "type": ["string", "null"] },
        "additionalVariantPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "format": { "type": "string", "enum": ["png", "jpg"] },
        "colorSpace": { "type": "string", "const": "sRGB" },
        "hasAlpha": { "type": "boolean" },
        "previewPath": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "safeInsets": {
          "oneOf": [{ "$ref": "#/$defs/safeInsets" }, { "type": "null" }]
        },
        "contentRegions": {
          "type": "array",
          "items": { "$ref": "#/$defs/contentRegion" }
        },
        "textRegions": {
          "type": "array",
          "items": { "$ref": "#/$defs/textRegion" }
        },
        "transparentApertures": {
          "type": "array",
          "items": { "$ref": "#/$defs/transparentAperture" }
        }
      }
    },
    "assetEntry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "styleFamily",
        "tags",
        "description",
        "variants",
        "dominantColors",
        "recommendedTextColor",
        "usageNotes",
        "suggestedFitMode",
        "recommendedLayer",
        "layerOrder",
        "suggestedMotion",
        "integrationStatus",
        "provenanceId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^fc-v1-[a-z0-9-]+$" },
        "name": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["backgrounds", "stream-scenes", "frames", "cards", "annotations"]
        },
        "subcategory": { "type": "string" },
        "styleFamily": {
          "type": "string",
          "enum": ["obsidian-mint", "paper-ink", "warm-studio", "deep-blue"]
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "description": { "type": "string" },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "horizontal": { "$ref": "#/$defs/variantEntry" },
            "vertical": { "$ref": "#/$defs/variantEntry" },
            "universal": { "$ref": "#/$defs/variantEntry" }
          }
        },
        "dominantColors": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "recommendedTextColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "usageNotes": { "type": "string" },
        "suggestedFitMode": {
          "type": "string",
          "enum": ["fill", "fit"]
        },
        "recommendedLayer": {
          "type": "string",
          "enum": ["background", "scene-plate", "frame-overlay", "card-overlay", "annotation-overlay"]
        },
        "layerOrder": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggestedMotion": {
          "type": ["string", "null"],
          "enum": ["fade", "slide", "rise", "pop", null]
        },
        "integrationStatus": {
          "type": "string",
          "enum": ["image-source-ready", "requires-native-template-integration"]
        },
        "provenanceId": { "type": "string" }
      }
    }
  }
}
