{
  "schemaVersion": 1,
  "packId": "framecast-creator-assets-v1",
  "version": "1.0.0",
  "coordinateConvention": {
    "system": "normalized-top-left",
    "origin": "top-left (0.0, 0.0)",
    "bounds": "[0.0, 1.0] for x, y, width, height",
    "coreImageConversionNote": "Core Image (CIImage) uses a bottom-left Cartesian origin where y_ci = (1.0 - y_top_left - height) * canvasHeight. All coordinates in manifest.json and design-tokens.json use top-left normalized coordinates [0, 1] and must be flipped on the Y axis when constructing CIVector/CGRect in the Core Image compositor."
  },
  "canvasStandards": {
    "horizontal": {
      "width": 3840,
      "height": 2160,
      "aspectRatio": "16:9",
      "quietZone": { "x": 0.15, "y": 0.175, "width": 0.70, "height": 0.65 },
      "defaultSafeInsets": { "top": 0.05, "right": 0.05, "bottom": 0.06, "left": 0.05 }
    },
    "vertical": {
      "width": 2160,
      "height": 3840,
      "aspectRatio": "9:16",
      "quietZone": { "x": 0.12, "y": 0.16, "width": 0.72, "height": 0.62 },
      "defaultSafeInsets": {
        "top": 0.08,
        "right": 0.14,
        "bottom": 0.18,
        "left": 0.06,
        "note": "Portrait safe insets reserve extra right (14%) and bottom (18%) clearance for vertical live-stream/short-form platform UI controls (like/comment rail and caption/description chrome). Platform overlays vary by service and device; these insets are recommended targets rather than universal guarantees."
      }
    },
    "annotationMaxLongEdge": 2048
  },
